# Stack Overflow Enterprise
SO_BASE_URL=https://your-instance.stackenterprise.co/api/v3
SO_API_KEY=your-api-key-here
SO_TEAM=
# Optional: path to a PEM file of extra CA certificate(s) to trust, for an
# on-prem instance behind an internal/corporate CA. Leave blank to use the
# system trust store. Certificates are always verified either way.
SO_CA_BUNDLE=
# Opt-in escape hatch: disables TLS certificate verification entirely.
# Only for instances with a self-signed cert SO_CA_BUNDLE can't cover.
# Defaults to false; leave it that way unless you specifically need it.
SO_INSECURE_SKIP_VERIFY=false

# Ollama (local inference)
OLLAMA_URL=http://localhost:11434
# Model used for the remediation guide. Blank = same model as classification.
# Remediation is a handful of long-form reasoning calls per run while
# classification is thousands of short structured ones, so a small fast
# classifier can be paired with a larger model here at little cost.
REMEDIATION_MODEL=
# Questions per classification prompt. Smaller batches produce shorter output
# lists, which small models are less likely to miscount; larger batches re-send
# the taxonomy and few-shot prefix less often. Try 8 with a 3B model, 20 with 8B.
CLASSIFY_BATCH_SIZE=20

# Storage paths (relative to backend/)
DB_PATH=./data/soinsight.db
CHROMA_PATH=./data/chroma

# Optional tuning
LOG_LEVEL=INFO
# Also fetch each new question's answers during ingestion (true/false).
# Adds one API call per newly-inserted question that has answers.
FETCH_ANSWERS=true
# How many of those answer-fetch calls run concurrently. This is the dominant
# cost of a large first-time fetch; raising it cuts wall-clock time roughly
# linearly up to what your SO Enterprise instance can comfortably absorb at
# once. Keep conservative on a shared/on-prem instance.
ANSWER_FETCH_CONCURRENCY=10
